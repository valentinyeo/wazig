<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for WAZI-31, built with wixl (msitools) on the Linux release runner.

  Installs to %LOCALAPPDATA%\Programs\Messages, the standard per-user install
  location, on purpose: the in-app updater (src/main.zig) swaps Messages.exe in
  its own directory, which needs no elevation there but would fail in
  Program Files. Windows Installer registers the product in Add/Remove
  Programs itself; no custom uninstall key is authored.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Wazig Messages"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Wazig"
           UpgradeCode="E2C53374-5665-593B-94F8-38573F3164D2">
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             Description="Wazig Messages installer"
             Manufacturer="Wazig" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Wazig Messages is already installed." />
    <Media Id="1" Cabinet="messages.cab" EmbedCab="yes" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Messages" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MessagesExe" Guid="4FC6E44E-17A5-5F45-958F-020449338BFF">
        <File Id="MessagesExeFile" Name="Messages.exe" Source="$(var.BinDir)Messages.exe" KeyPath="yes" />
      </Component>
      <Component Id="PlexRegular" Guid="1A96D346-DF77-5C8D-AF3B-857F10E50DFF">
        <File Id="PlexRegularFile" Name="IBMPlexSans-Regular.ttf" Source="$(var.BinDir)IBMPlexSans-Regular.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexSemiBold" Guid="E8332C91-8C69-5F65-8A73-FA273D2713CE">
        <File Id="PlexSemiBoldFile" Name="IBMPlexSans-SemiBold.ttf" Source="$(var.BinDir)IBMPlexSans-SemiBold.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexLicense" Guid="FC9F0507-8A60-5970-B349-BC675F7C44D5">
        <File Id="PlexLicenseFile" Name="IBM-Plex-LICENSE.txt" Source="$(var.BinDir)IBM-Plex-LICENSE.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <!-- HKCU value is the component keypath so the shortcut is removed on
           uninstall; MSI per-user ARP registration comes from Product metadata. -->
      <Component Id="StartMenuShortcut" Guid="29415F78-0826-52C8-9F9D-2457573E2144">
        <RegistryValue Root="HKCU" Key="Software\Wazig\Messages"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="MessagesShortcut"
                  Name="Messages"
                  Description="Wazig Messages"
                  Target="[INSTALLDIR]Messages.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Wazig Messages" Level="1">
      <ComponentRef Id="MessagesExe" />
      <ComponentRef Id="PlexRegular" />
      <ComponentRef Id="PlexSemiBold" />
      <ComponentRef Id="PlexLicense" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
